# VT2 — Verifiable Trading Technology
# Environment Configuration Template
# NOTE: Platform defaults to PAPER mode on startup.
# LIVE trading requires LIVE_TRADING_ENABLED=true and multi-step explicit user arming.

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Path (defaults to local SQLite file in data/)
DATABASE_PATH=data/vt2.db

# Bitget Public Market Data Endpoint (Public REST / UTA v3)
BITGET_API_BASE_URL=https://api.bitget.com

# Bitget Demo Trading Credentials (Simulated funds on Bitget exchange)
BITGET_DEMO_API_KEY=
BITGET_DEMO_API_SECRET=
BITGET_DEMO_PASSPHRASE=

# Bitget Live Trading Credentials (Real capital on Bitget exchange)
# LIVE execution is strictly local-only and requires explicit interactive arming
LIVE_TRADING_ENABLED=false
BITGET_LIVE_API_KEY=
BITGET_LIVE_API_SECRET=
BITGET_LIVE_API_PASSPHRASE=

# Optional External AI Provider (Defaults to Deterministic Rules Engine if unset)
# AI_PROVIDER=gemini # or openai, anthropic
# AI_API_KEY=
